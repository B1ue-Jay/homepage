---

<div class="socials">
  {
    socials.map((s) =>
      ICONS[s.type] ? (
        <a
          href={s.url}
          aria-label={s.label}
          title={s.label}
          rel="me noopener"
          target={s.type === 'email' ? undefined : '_blank'}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={ICONS[s.type]} />
          </svg>
        </a>
      ) : null
    )
  }
</div>
