---
import Base from '../layouts/Base.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { site, CTA_ACCENT_FONT, link } from '../config';
import { publications } from '../data/publications';
import { news } from '../data/news';
import { formatAuthors, hasAuthorMarks } from '../utils/authors';

const selected = publications.filter((p) => p.selected);
const selectedHasMarks = hasAuthorMarks(selected);
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">{site.role} · {site.field}</p>
        <h1>{site.name}</h1>
        <p class="role"><strong>{site.role}</strong> at {site.affiliation}</p>
        <p class="lead">{site.tagline}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={link('/') + '#contact'}>Get in touch</a>
          {site.cv && <a class="btn btn-ghost" href={site.cv}>Download CV</a>}
        </div>
      </div>
      <div class="hero-figure">
        <!-- 单条细青色弧线点缀，藏在照片右上角后方（原创装饰，非搬运素材）-->
        <svg class="portrait-arc" viewBox="0 0 120 120" fill="none" aria-hidden="true" focusable="false">
          <path
            d="M110 18 A 92 92 0 0 1 110 102"
            stroke="var(--accent)"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-opacity="0.85"
          />
        </svg>
        <!-- 换成你的照片：把文件放到 public/ 下并改这里的 src，例如 /me.jpg -->
        <img class="avatar" src={link('/avatar.jpg')} alt={`Portrait of ${site.name}`} width="320" height="400" />
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section" id="about">
    <div class="container">
      <h2>About me</h2>
      {site.about.map((para) => <p class="lead">{para}</p>)}
      <div style="margin-top:1.5rem">
        <SocialIcons />
      </div>
    </div>
  </section>

  <!-- News -->
  {
    news.length > 0 && (
      <section class="section band" id="news">
        <div class="container">
          <h2>News</h2>
          <ul class="news-list">
            {news.map((n) => (
              <li class="news-item">
                <span class="news-date">{n.date}</span>
                <span class="news-text" set:html={n.html} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Selected publications (moved here from the Research page) -->
  {
    selected.length > 0 && (
      <section class="section" id="selected-publications">
        <div class="container">
          <h2>Selected publications</h2>
          {selectedHasMarks && (
            <p class="authors-legend">
              <sup class="aff">*</sup> Equal contribution&ensp;·&ensp;<sup class="aff">†</sup> Corresponding author
            </p>
          )}
          <ul class="pub-list">
            {selected.map((p) => (
              <li class="pub">
                <div class="title">{p.title}</div>
                <div class="authors" set:html={formatAuthors(p.authors)} />
                <div class="venue">{p.venue} · {p.year}</div>
                {p.links && (
                  <div class="pub-links">
                    {Object.entries(p.links).map(([k, v]) =>
                      v ? (
                        <a href={v} target="_blank" rel="noopener">
                          {k === 'pdf' ? 'PDF' : k === 'arxiv' ? 'arXiv' : k === 'doi' ? 'DOI' : k === 'code' ? 'Code' : 'Project'}
                        </a>
                      ) : null
                    )}
                  </div>
                )}
              </li>
            ))}
          </ul>
          <p style="margin-top:1.5rem">
            <a class="btn btn-ghost" href={link('/publications')}>See all publications →</a>
          </p>
        </div>
      </section>
    )
  }

  <!-- Contact CTA -->
  <section class="section cta" id="contact">
    <div class="container">
      <h2>Get in touch</h2>
      <p class="lead">
        I'm open to research collaborations and industry opportunities. The fastest way to reach me is by email.
      </p>
      <a
        class:list={['btn', 'btn-primary', 'btn-sm', { 'font-accent': CTA_ACCENT_FONT }]}
        href={`mailto:${site.email}`}
      >
        {site.email}
      </a>
      <div style="margin-top:1.5rem;display:flex;justify-content:center">
        <SocialIcons />
      </div>
    </div>
  </section>
</Base>
