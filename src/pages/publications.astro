---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { publications } from '../data/publications';
import { formatAuthors, hasAuthorMarks } from '../utils/authors';

const LINK_LABELS: Record<string, string> = {
  pdf: 'PDF',
  code: 'Code',
  doi: 'DOI',
  arxiv: 'arXiv',
  project: 'Project',
};

// group by year, newest first
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const showLegend = hasAuthorMarks(publications);
---

<Base title="Publications" description="Peer-reviewed papers and preprints.">
  <PageHeader title="Publications" lead="Peer-reviewed papers, preprints, and selected works." />

  <section class="section">
    <div class="container">
      {showLegend && (
        <p class="authors-legend">
          <sup class="aff">*</sup> Equal contribution&ensp;·&ensp;<sup class="aff">†</sup> Corresponding author
        </p>
      )}
      {
        years.map((year) => (
          <div class="pub-group">
            <div class="pub-year">{year}</div>
            <ul class="pub-list">
              {publications
                .filter((p) => p.year === year)
                .map((p) => (
                  <li class="pub">
                    <div class="title">{p.title}</div>
                    <div class="authors" set:html={formatAuthors(p.authors)} />
                    <div class="venue">{p.venue}</div>
                    {p.links && (
                      <div class="pub-links">
                        {Object.entries(p.links).map(([k, v]) =>
                          v ? (
                            <a href={v} target="_blank" rel="noopener">
                              {LINK_LABELS[k] ?? k}
                            </a>
                          ) : null
                        )}
                      </div>
                    )}
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>
