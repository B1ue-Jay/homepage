---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { teaching } from '../data/teaching';
---

<Base title="Teaching" description="Courses and teaching experience.">
  <PageHeader title="Teaching" lead="Courses I have taught or assisted." />

  <section class="section">
    <div class="container">
      <ul class="entry-list">
        {
          teaching.map((t) => (
            <li class="entry">
              <div class="head">
                <span class="name">{t.name}</span>
                <span class="when">{t.when}</span>
              </div>
              <div class="meta">{t.role} · {t.org}</div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
